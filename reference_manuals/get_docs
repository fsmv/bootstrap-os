# Downloads pdf documents for IBM PC programming and adds bookmarks using TeX.
#
# Without asking it downloads the essentials:
#  - The PS/2 BIOS manual which has the nicest listing of the BIOS interrupts 
#  - The modern Intel Software Developers Manual which has info about x86
#
# It prompts to ask if you'd like other relevant manuals as well and optionally
# can add PDF bookmarks to some of the PDFs.

if [ -z "$BITSAVERS" ]; then
 # As of April 2026 bitsavers banned wget because of too much traffic
 #BITSAVERS=https://bitsavers.org
 BITSAVERS=https://bitsavers.trailing-edge.com/
fi
BIOS_DOC_NAME=IBM_PS2_BIOS_Manual_1988.pdf
VGA_DOC_NAME=IBM_VGA_Manual_1992.pdf
PC_DOC_NAME=IBM_PC_Manual_1981.pdf

echo "The official Intel Software Developer's Manual and the Optimization Manual can be downloaded from:"
echo "https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html"
echo "If the links haven't moved this script will download them automatically."

wget -nc --no-check-certificate https://cdrdv2-public.intel.com/789583/325462-sdm-vol-1-2abcd-3abcd-4.pdf -O Intel_Software_Developers_Manual.pdf
wget -nc $BITSAVERS/pdf/ibm/pc/ps2/15F0306_PS2_and_PC_BIOS_Interface_Technical_Reference_May88.pdf -O $BIOS_DOC_NAME

PC_MANUAL=0
echo "By default this script downloaded the comprehensive IBM BIOS manual from 1988"
echo "Do you want the Original 1981 IBM Personal Computer technical manual as well?"
echo -n "This is useful for maximum compatibility with the oldest PCs. [y/n]: "
read ans
if [[ $ans =~ ^[Yy] ]]; then
  wget -nc $BITSAVERS/pdf/ibm/pc/pc/6025008_PC_Technical_Reference_Aug81.pdf -O $PC_DOC_NAME
  PC_MANUAL=1
fi

echo -n "Do you want the (modern) Intel Optimization Manual? [y/n]: "
read ans
if [[ $ans =~ ^[Yy] ]]; then
  wget -nc --no-check-certificate https://cdrdv2-public.intel.com/671488/248966-Software-Optimization-Manual-V1-048.pdf -O Intel_Optimization_Manual.pdf
fi

VGA_MANUAL=0
echo -n "Do you want the 1992 IBM VGA (Graphics Adapter) Manual? [y/n]: "
read ans
if [[ $ans =~ ^[Yy] ]]; then
  VGA_MANUAL=1
  wget -nc $BITSAVERS/pdf/ibm/pc/cards/IBM_VGA_XGA_Technical_Reference_Manual_May92.pdf -O $VGA_DOC_NAME
fi

echo -n "Add bookmarks to the manuals? (using pdflatex) [y/n]: "
read ans
if [[ $ans =~ ^[Yy] ]]; then
  echo
  echo "Uses the packages: inputenc, pdfpages, bookmark, hyperref"
  echo "You may have to install them and run this script again"
  echo

  pdflatex --jobname=temp --interaction=batchmode \
    "\\def\\filename{$BIOS_DOC_NAME}\\input{add_bookmarks_to_bios_manual.tex}" \
    && rm temp.{log,aux} \
    && rm $BIOS_DOC_NAME && mv temp.pdf $BIOS_DOC_NAME

  if [ $PC_MANUAL -eq 1 ]; then
    pdflatex --jobname=temp --interaction=batchmode \
      "\\def\\filename{$PC_DOC_NAME}\\input{add_bookmarks_to_pc_manual.tex}" \
      && rm temp.{log,aux} \
      && rm $PC_DOC_NAME && mv temp.pdf $PC_DOC_NAME
  fi

  #if [ $VGA_MANUAL -eq 1 ]; then
  #  pdflatex --jobname=temp --interaction=batchmode \
  #    "\\def\\filename{$VGA_DOC_NAME}\\input{add_bookmarks_to_vga_manual.tex}" \
  #    && rm temp.{log,aux} \
  #    && rm $VGA_DOC_NAME && mv temp.pdf $VGA_DOC_NAME
  #fi
fi

